{
  "name": "@gryphoon/texy",
  "description": "Node.js port of the Texy text-to-HTML converter",
  "version": "3.0.0",
  "license": "BSD-3-Clause",
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "/license.md",
    "/README.md",
    "/index.js",
    "/src"
  ],
  "exports": {
    ".": "./index.js",
    "./*.js": "./src/*.js"
  },
  "scripts": {
    "test": "node --test --experimental-test-tag-filter='!fuzz' tests/",
    "test:fuzz": "node --test --experimental-test-tag-filter='fuzz' tests/",
    "test:all": "node --test tests/"
  },
  "dependencies": {
    "linkedom": "0.18.15"
  },
  "packageManager": "yarn@4.18.1"
}
