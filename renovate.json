{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "groupName": "pulumi",
      "matchPackageNames": [
        "@pulumi/{/,}**"
      ]
    },
    {
      "groupName": "thi.ng",
      "matchPackageNames": [
        "@thi.ng/{/,}**"
      ]
    },
    {
      "groupName": "cloudflare",
      "matchPackageNames": [
        "@cloudflare/{/,}**",
        "/wrangler/"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
